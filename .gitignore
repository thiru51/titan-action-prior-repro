# Data and outputs
# data/* rather than data/, because git will not look inside an excluded
# directory and so cannot see the un-ignore rule below it.
data/*
# ETH/UCY is public, small (7 MB) and the only real data this repo can run on,
# so it is committed to make RESULTS.md verifiable from a clean clone.
!data/datasets/
checkpoints/
runs/
outputs/
wandb/
*.pt
*.pth
*.ckpt
*.tar
*.npz

# Environments
.pixi/
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local config and secrets
.env
*.local.yaml

# Editors and OS
.vscode/
.idea/
.DS_Store
